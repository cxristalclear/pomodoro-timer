# Supabase project credentials — Settings > API in the Supabase dashboard.
# Copy to .env.local for local dev and set the same values in Vercel.
# Both are safe to expose to the browser; Row Level Security (see
# scripts/00-rebuild-all.sql) is what protects your data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
